DB_URL=your_value
DB_PORT=your_value
DB_NAME=your_value
DB_USERNAME=your_value
DB_PASSWORD=your_value

# --- Optionnel (valeurs par défaut dans application*.yaml) ---
# SPRING_PROFILES_ACTIVE=dev
# JWT_ACCESS_TOKEN_EXPIRATION=8640000
# JWT_REFRESH_TOKEN_EXPIRATION=604800000

