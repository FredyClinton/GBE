                    <mxGeometry height="190" width="300" x="2280" y="310" as="geometry" />
                </mxCell>
                <mxCell id="p5_Fournisseur" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1E293B;" value="&lt;p style='margin:0;margin-top:5px;text-align:center;'&gt;&lt;b&gt;Fournisseur&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#64748B;'&gt;Table: fournisseurs (Externe)&lt;/i&gt;&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:0;margin-left:8px;line-height:1.45;'&gt;- id : String [UUID]&lt;br&gt;- raisonSociale : String&lt;br&gt;- niu : String [Unique, Fiscal]&lt;br&gt;- rccm : String [Registre]&lt;br&gt;- adresse : String&lt;br&gt;- telephone : String [Entreprise]&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:0;margin-left:8px;line-height:1.45;'&gt;+ ajouterRib(rib : String) : CoordonneeBancaire&lt;br&gt;+ retirerRib(id : String)&lt;br&gt;+ getCoordonneesBancaires() : List&lt;/p&gt;" vertex="1">
                    <mxGeometry height="220" width="280" x="100" y="680" as="geometry" />
                </mxCell>
                <mxCell id="p5_CoordonneeBancaire" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1E293B;" value="&lt;p style='margin:0;margin-top:5px;text-align:center;'&gt;&lt;b&gt;CoordonneeBancaire&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#64748B;'&gt;Table: coordonnees_bancaires&lt;/i&gt;&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:0;margin-left:8px;line-height:1.45;'&gt;- id : String [UUID]&lt;br&gt;- rib : String [23 caractères]&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;i style='color:#555;'&gt;Banque(5)+Guichet(5)+Cpte(11)+Clé(2)&lt;/i&gt;&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:0;margin-left:8px;line-height:1.45;'&gt;+ {static} normaliserRib(rib) : String&lt;br&gt;+ {static} isRibValide(rib) : boolean&lt;/p&gt;" vertex="1">
                    <mxGeometry height="140" width="280" x="100" y="930" as="geometry" />
                </mxCell>
                <mxCell id="p5_RoleSysteme" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1E293B;" value="&lt;p style='margin:0;margin-top:5px;text-align:center;'&gt;&lt;i style='font-size:11px;color:#475569;'&gt;&amp;laquo;enumeration&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;RoleSysteme&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#64748B;'&gt;Rôles Métier de l'Administration&lt;/i&gt;&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:0;margin-left:8px;line-height:1.5;'&gt;&lt;b&gt;ADMIN&lt;/b&gt; (&lt;i style='color:#0284C7;'&gt;&amp;quot;Administrateur&quot;&lt;/i&gt;)&lt;br&gt;&lt;b&gt;MINISTRE&lt;/b&gt; (&lt;i style='color:#0284C7;'&gt;&amp;quot;Ministre&quot;&lt;/i&gt;)&lt;br&gt;&lt;b&gt;ORDONNATEUR&lt;/b&gt; (&lt;i style='color:#0284C7;'&gt;&amp;quot;Ordonnateur&quot;&lt;/i&gt;)&lt;br&gt;&lt;b&gt;CONTROLEUR_FINANCIER&lt;/b&gt; (&lt;i style='color:#0284C7;'&gt;&amp;quot;Contrôleur financier&quot;&lt;/i&gt;)&lt;br&gt;&lt;b&gt;COMPTABLE&lt;/b&gt; (&lt;i style='color:#0284C7;'&gt;&amp;quot;Comptable Public / Trésor&quot;&lt;/i&gt;)&lt;br&gt;&lt;b&gt;COMPTABLE_MATIERE&lt;/b&gt; (&lt;i style='color:#0284C7;'&gt;&amp;quot;Comptable matière&quot;&lt;/i&gt;)&lt;br&gt;&lt;b&gt;FOURNISSEUR&lt;/b&gt; (&lt;i style='color:#0284C7;'&gt;&amp;quot;Fournisseur&quot;&lt;/i&gt; [externe])&lt;br&gt;&lt;b&gt;GESTIONNAIRE&lt;/b&gt; (&lt;i style='color:#0284C7;'&gt;&amp;quot;Gestionnaire&quot;&lt;/i&gt; [lecture])&lt;br&gt;&lt;b&gt;AGENT&lt;/b&gt; (&lt;i style='color:#0284C7;'&gt;&amp;quot;Agent&quot;&lt;/i&gt; [rôle de base])&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:0;margin-left:8px;line-height:1.45;'&gt;+ getLibelle() : String&lt;br&gt;+ getDefaultPermissions() : Set&amp;lt;Permission&amp;gt;&lt;br&gt;+ isExterne() : boolean&lt;/p&gt;" vertex="1">
                    <mxGeometry height="360" width="360" x="440" y="680" as="geometry" />
                </mxCell>
                <mxCell id="p5_Permission" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1E293B;" value="&lt;p style='margin:0;margin-top:5px;text-align:center;'&gt;&lt;i style='font-size:11px;color:#475569;'&gt;&amp;laquo;enumeration&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;Permission&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#64748B;'&gt;Habiletés Métier (Ce que l'utilisateur peut faire)&lt;/i&gt;&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:0;margin-left:8px;line-height:1.4;'&gt;&lt;b style='color:#1E3A8A;'&gt;── Besoins &amp;amp; Offres ──&lt;/b&gt;&lt;br&gt;• &lt;b&gt;EXPRIMER_BESOIN&lt;/b&gt; : Créer et publier une expression de besoin&lt;br&gt;• &lt;b&gt;SOUMISSIONNER&lt;/b&gt; : Déposer une offre chiffrée (Fournisseur)&lt;br&gt;&lt;b style='color:#1E3A8A;'&gt;── Engagement Juridique &amp;amp; Actes ──&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ENGAGE_DEPENSE&lt;/b&gt; : Établir le projet d'acte (BCA), l'annuler&lt;br&gt;• &lt;b&gt;SIGNER_ACTE&lt;/b&gt; : Signer l'acte visé et le notifier au fournisseur&lt;br&gt;• &lt;b&gt;REVISER_AE&lt;/b&gt; : Réviser les Autorisations d'Engagement&lt;br&gt;• &lt;b&gt;REVISER_CP&lt;/b&gt; : Réviser les Crédits de Paiement&lt;br&gt;• &lt;b&gt;REJETER_DEPENSE&lt;/b&gt; : Rejeter un projet de dépense&lt;br&gt;&lt;b style='color:#1E3A8A;'&gt;── Contrôle Financier (Art. 70) ──&lt;/b&gt;&lt;br&gt;• &lt;b&gt;VISA_CFI&lt;/b&gt; : Viser l'acte d'engagement juridique&lt;br&gt;• &lt;b&gt;REJETER_CFI&lt;/b&gt; : Rejeter l'acte au Contrôle Financier&lt;br&gt;• &lt;b&gt;RESERVER_CREDIT&lt;/b&gt; : Réserver / bloquer les AE sur la ligne&lt;br&gt;• &lt;b&gt;QUITUS_NATURE&lt;/b&gt; : Délivrer le quitus de conformité de nature&lt;br&gt;• &lt;b&gt;VISER_ORDONNANCEMENT&lt;/b&gt; : Viser l'ordonnancement de paiement&lt;br&gt;&lt;b style='color:#1E3A8A;'&gt;── Réception Matière ──&lt;/b&gt;&lt;br&gt;• &lt;b&gt;RECEPTIONNER_LIVRAISON&lt;/b&gt; : Prendre en charge et dresser le PV&lt;br&gt;&lt;b style='color:#1E3A8A;'&gt;── Liquidation, Ordonnancement &amp;amp; Trésor ──&lt;/b&gt;&lt;br&gt;• &lt;b&gt;LIQUIDER_DEPENSE&lt;/b&gt; : Constater le service fait &amp;amp; liquider&lt;br&gt;• &lt;b&gt;ORDONNANCER&lt;/b&gt; : Émettre et signer l'ordonnance de paiement&lt;br&gt;• &lt;b&gt;PAYER_DEPENSE&lt;/b&gt; : Exécuter le règlement bancaire (Trésor)&lt;br&gt;&lt;b style='color:#1E3A8A;'&gt;── Administration &amp;amp; Consultation ──&lt;/b&gt;&lt;br&gt;• &lt;b&gt;INSCRIRE_CREDIT&lt;/b&gt; : Doter/inscrire un crédit budgétaire initial&lt;br&gt;• &lt;b&gt;MANAGE_USERS&lt;/b&gt; : Gérer les comptes utilisateurs et agents&lt;br&gt;• &lt;b&gt;MANAGE_AFFECTATIONS&lt;/b&gt; : Gérer les mandats et leurs permissions&lt;br&gt;• &lt;b&gt;CONSULTER&lt;/b&gt; : Consulter les crédits et dépenses du périmètre&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:0;margin-left:8px;line-height:1.45;'&gt;+ getLibelle() : String&lt;/p&gt;" vertex="1">
                    <mxGeometry height="540" width="500" x="860" y="680" as="geometry" />
                </mxCell>
                <mxCell id="p5_MandatScopeValidator" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1E293B;" value="&lt;p style='margin:0;margin-top:5px;text-align:center;'&gt;&lt;i style='font-size:11px;color:#475569;'&gt;&amp;laquo;component&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;MandatScopeValidator&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#64748B;'&gt;Contrôle d'Accès par Périmètre&lt;/i&gt;&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:0;margin-left:8px;line-height:1.45;'&gt;+ checkAccessCredit(credit)&lt;br&gt;+ checkAccessCreditWithPermission(c, p)&lt;br&gt;+ checkAccessPerimetre(secId, progId, p)&lt;br&gt;+ checkSectionAccess(secId)&lt;br&gt;+ perimetreCourant() : Perimetre&lt;br&gt;+ getProgrammeIdsAutorises(secId) : Set&lt;/p&gt;" vertex="1">
                    <mxGeometry height="200" width="340" x="1420" y="680" as="geometry" />
                </mxCell>
                <mxCell id="p5_Perimetre" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1E293B;" value="&lt;p style='margin:0;margin-top:5px;text-align:center;'&gt;&lt;i style='font-size:11px;color:#475569;'&gt;&amp;laquo;record&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;Perimetre&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#64748B;'&gt;Value Object Scope Filtrage SQL&lt;/i&gt;&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:0;margin-left:8px;line-height:1.45;'&gt;- sectionsEntieres : Set&amp;lt;String&amp;gt;&lt;br&gt;- programmes : Set&amp;lt;String&amp;gt;&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:0;margin-left:8px;line-height:1.45;'&gt;+ isVide() : boolean&lt;br&gt;+ contient(sectionId, programmeId) : boolean&lt;/p&gt;" vertex="1">
                    <mxGeometry height="150" width="340" x="1420" y="910" as="geometry" />
                </mxCell>
                <mxCell id="p5_NoteSecurite" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#fbc02d;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;" value="&lt;b&gt;CONTRÔLE DE SÉCURITÉ EN 2 NIVEAUX :&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Niveau Endpoint API :&lt;/b&gt;&lt;br&gt;&lt;code&gt;@PreAuthorize(&quot;hasAuthority('...')&quot;)&lt;/code&gt;&lt;br&gt;Vérifie que l'utilisateur possède l'habileté requise (permissions du mandat ou du rôle).&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Niveau Périmètre (Scope) :&lt;/b&gt;&lt;br&gt;&lt;code&gt;MandatScopeValidator&lt;/code&gt;&lt;br&gt;• &lt;b&gt;MINISTRE&lt;/b&gt; sans programme = toute la section.&lt;br&gt;• &lt;b&gt;ORDONNATEUR&lt;/b&gt; = restreint à son programme.&lt;br&gt;• &lt;b&gt;FOURNISSEUR&lt;/b&gt; = sans mandat, accès strict à ses propres offres et demandes." vertex="1">
                    <mxGeometry height="210" width="360" x="1820" y="680" as="geometry" />
                </mxCell>
                <mxCell id="p5_NoteJwt" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#fbc02d;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;" value="&lt;b&gt;AUTHENTIFICATION RENFORCÉE (MFA + RSA) :&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Login email + mot de passe (vérifié par BCrypt).&lt;br&gt;2. Si MFA activé : émission d'un &lt;b&gt;MFA_TOKEN&lt;/b&gt; court (interdit sur les routes métiers).&lt;br&gt;3. Vérification du code TOTP via &lt;i&gt;TwoFactorAuthenticationService&lt;/i&gt;.&lt;br&gt;4. Émission du couple &lt;b&gt;ACCES_TOKEN&lt;/b&gt; (durée courte) &amp;amp; &lt;b&gt;REFRESH_TOKEN&lt;/b&gt; signés RSA-2048." vertex="1">
                    <mxGeometry height="210" width="360" x="2220" y="680" as="geometry" />
                </mxCell>
                <mxCell id="p5_matrix_table" parent="1" style="text;html=1;align=left;verticalAlign=top;rounded=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=0;" value="&lt;div style='font-family:Arial,sans-serif;padding:6px;'&gt;&lt;h3 style='margin:0;margin-bottom:8px;color:#1E3A8A;text-align:center;font-size:14px;'&gt;MATRICE EXHAUSTIVE DES ACTEURS, FONCTIONS, SCOPES &amp;amp; HABILITÉS CONCRÈTES DANS LE CYCLE DE LA DÉPENSE&lt;/h3&gt;&lt;table style='width:100%;border-collapse:collapse;font-size:11px;text-align:left;' border='1' cellpadding='4' cellspacing='0'&gt;&lt;tr style='background-color:#1E3A8A;color:#ffffff;font-weight:bold;text-align:center;'&gt;&lt;th style='width:12%;'&gt;Rôle Système&lt;/th&gt;&lt;th style='width:7%;'&gt;Statut&lt;/th&gt;&lt;th style='width:13%;'&gt;Périmètre (Scope)&lt;/th&gt;&lt;th style='width:22%;'&gt;Fonctions Métier Attribuées&lt;/th&gt;&lt;th style='width:23%;'&gt;Habiletés Effectives (Permissions)&lt;/th&gt;&lt;th style='width:23%;'&gt;Ce qu'il peut faire concrètement dans l'application&lt;/th&gt;&lt;/tr&gt;&lt;tr style='background-color:#F8FAFC;'&gt;&lt;td&gt;&lt;b style='color:#B45309;'&gt;ADMIN&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748B;'&gt;Administrateur Système&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;span style='background:#E0E7FF;color:#3730A3;padding:2px 4px;border-radius:3px;font-weight:bold;'&gt;Interne&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Global / Transversal&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Garant du référentiel, gestion des comptes utilisateurs, attribution des mandats, dotation initiale des crédits.&lt;/td&gt;&lt;td&gt;&lt;code&gt;MANAGE_USERS&lt;/code&gt;&lt;br&gt;&lt;code&gt;MANAGE_AFFECTATIONS&lt;/code&gt;&lt;br&gt;&lt;code&gt;INSCRIRE_CREDIT&lt;/code&gt;&lt;/td&gt;&lt;td&gt;• Créer/éditer les comptes Users, Agents, Fournisseurs&lt;br&gt;• Affecter les mandats (rôles &amp;amp; programmes)&lt;br&gt;• Gérer le catalogue des matières, taxes, tâches&lt;br&gt;• Inscrire les lignes de crédit budgétaire initiales&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#FFFFFF;'&gt;&lt;td&gt;&lt;b style='color:#0F766E;'&gt;MINISTRE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748B;'&gt;Ordonnateur Principal&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;span style='background:#E0E7FF;color:#3730A3;padding:2px 4px;border-radius:3px;font-weight:bold;'&gt;Interne&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Section Entière&lt;/b&gt;&lt;br&gt;&lt;i&gt;programme=null&lt;/i&gt;&lt;/td&gt;&lt;td&gt;Pilotage stratégique ministériel, arbitrage, validation des dépenses majeures, réallocation budgétaire globale.&lt;/td&gt;&lt;td&gt;&lt;code&gt;ENGAGE_DEPENSE&lt;/code&gt;, &lt;code&gt;REVISER_AE&lt;/code&gt;, &lt;code&gt;REVISER_CP&lt;/code&gt;&lt;br&gt;&lt;code&gt;REJETER_DEPENSE&lt;/code&gt;, &lt;code&gt;EXPRIMER_BESOIN&lt;/code&gt;&lt;br&gt;&lt;code&gt;LIQUIDER_DEPENSE&lt;/code&gt;, &lt;code&gt;ORDONNANCER&lt;/code&gt;, &lt;code&gt;SIGNER_ACTE&lt;/code&gt;&lt;br&gt;&lt;code&gt;MANAGE_USERS&lt;/code&gt;, &lt;code&gt;MANAGE_AFFECTATIONS&lt;/code&gt;&lt;/td&gt;&lt;td&gt;• Vue transversale sur tous les programmes de sa section&lt;br&gt;• Exprimer/valider un besoin au niveau ministériel&lt;br&gt;• Signer les actes d'engagement juridique majeurs&lt;br&gt;• Réviser les montants AE et CP sur ses lignes&lt;br&gt;• Signer les ordonnances de paiement ministérielles&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#F8FAFC;'&gt;&lt;td&gt;&lt;b style='color:#1D4ED8;'&gt;ORDONNATEUR&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748B;'&gt;Sous-ordonnateur / Resp. Prog.&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;span style='background:#E0E7FF;color:#3730A3;padding:2px 4px;border-radius:3px;font-weight:bold;'&gt;Interne&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Programme Restreint&lt;/b&gt;&lt;br&gt;Section + Programme assigné&lt;/td&gt;&lt;td&gt;Déclenchement opérationnel de la commande, attribution des offres, émission d'actes, liquidation, ordonnancement.&lt;/td&gt;&lt;td&gt;&lt;code&gt;EXPRIMER_BESOIN&lt;/code&gt;, &lt;code&gt;ENGAGE_DEPENSE&lt;/code&gt;, &lt;code&gt;SIGNER_ACTE&lt;/code&gt;&lt;br&gt;&lt;code&gt;LIQUIDER_DEPENSE&lt;/code&gt;, &lt;code&gt;ORDONNANCER&lt;/code&gt;&lt;br&gt;&lt;code&gt;REVISER_AE&lt;/code&gt;, &lt;code&gt;REVISER_CP&lt;/code&gt;&lt;/td&gt;&lt;td&gt;• Créer et publier des Expressions de Besoin (UC01)&lt;br&gt;• Consulter les offres et attribuer l'offre retenue (UC04)&lt;br&gt;• Établir le projet d'acte BCA et soumettre au CF&lt;br&gt;• Signer l'acte visé et le notifier au fournisseur (UC05)&lt;br&gt;• Constater le service fait et liquider la dépense (UC16)&lt;br&gt;• Signer le projet d'ordonnancement vers le Trésor (UC17)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#FFFFFF;'&gt;&lt;td&gt;&lt;b style='color:#15803D;'&gt;CONTROLEUR_FINANCIER&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748B;'&gt;Représentant DGB / MINFI (Art. 70)&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;span style='background:#E0E7FF;color:#3730A3;padding:2px 4px;border-radius:3px;font-weight:bold;'&gt;Interne&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Section / Ministère&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Contrôle préalable obligatoire de régularité et conformité des actes de dépense et ordonnancements, réservation bloquante des AE.&lt;/td&gt;&lt;td&gt;&lt;code&gt;VISA_CFI&lt;/code&gt;, &lt;code&gt;REJETER_CFI&lt;/code&gt;&lt;br&gt;&lt;code&gt;RESERVER_CREDIT&lt;/code&gt;&lt;br&gt;&lt;code&gt;QUITUS_NATURE&lt;/code&gt;&lt;br&gt;&lt;code&gt;VISER_ORDONNANCEMENT&lt;/code&gt;&lt;/td&gt;&lt;td&gt;• Examiner la conformité des matières et natures (UC08)&lt;br&gt;• Bloquer informatiquement les AE via &lt;b&gt;ReservationCredit&lt;/b&gt; (UC07)&lt;br&gt;• Apposer un visa FAVORABLE, REJET ou RÉSERVES (UC06)&lt;br&gt;• Contrôler et viser le dossier d'ordonnancement (UC19)&lt;br&gt;• Transmettre le dossier visé au comptable public&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#F8FAFC;'&gt;&lt;td&gt;&lt;b style='color:#7C3AED;'&gt;COMPTABLE_MATIERE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748B;'&gt;Magasinier / Réceptionnaire&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;span style='background:#E0E7FF;color:#3730A3;padding:2px 4px;border-radius:3px;font-weight:bold;'&gt;Interne&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Section / Programme&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Réception physique des fournitures/prestations, contrôle quantitatif et qualitatif, établissement du Procès-Verbal de Réception.&lt;/td&gt;&lt;td&gt;&lt;code&gt;RECEPTIONNER_LIVRAISON&lt;/code&gt;&lt;br&gt;&lt;code&gt;CONSULTER&lt;/code&gt;&lt;/td&gt;&lt;td&gt;• Réceptionner les livraisons du fournisseur (UC09)&lt;br&gt;• Contrôler la conformité au bon de commande administratif&lt;br&gt;• Établir le PV de Réception conforme ou avec réserves (UC10)&lt;br&gt;• Informer l'ordonnateur pour déclenchement liquidation (UC11)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#FFFFFF;'&gt;&lt;td&gt;&lt;b style='color:#C026D3;'&gt;COMPTABLE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748B;'&gt;Comptable Public / TPG&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;span style='background:#E0E7FF;color:#3730A3;padding:2px 4px;border-radius:3px;font-weight:bold;'&gt;Interne&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Poste Comptable / Trésor&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Contrôle de régularité comptable du mandat, validation du RIB bénéficiaire, paiement effectif par virement, apurement des CP.&lt;/td&gt;&lt;td&gt;&lt;code&gt;PAYER_DEPENSE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;• Prendre en charge le mandat d'ordonnancement visé&lt;br&gt;• Vérifier la validité des coordonnées bancaires du prestataire&lt;br&gt;• Émettre l'ordre de virement bancaire / règlement (Paiement)&lt;br&gt;• Consommer définitivement les Crédits de Paiement (CP)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#F8FAFC;'&gt;&lt;td&gt;&lt;b style='color:#DC2626;'&gt;FOURNISSEUR&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748B;'&gt;Prestataire / Candidat&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;span style='background:#FEE2E2;color:#991B1B;padding:2px 4px;border-radius:3px;font-weight:bold;'&gt;Externe&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Aucun Mandat&lt;/b&gt;&lt;br&gt;&lt;i&gt;isExterne=true&lt;/i&gt;&lt;/td&gt;&lt;td&gt;Répondre aux consultations publiques, soumettre des offres chiffrées scellées, gérer ses coordonnées bancaires.&lt;/td&gt;&lt;td&gt;&lt;code&gt;SOUMISSIONNER&lt;/code&gt;&lt;/td&gt;&lt;td&gt;• Consulter les besoins ouverts (&lt;code&gt;/api/v1/public/besoins&lt;/code&gt;, UC02)&lt;br&gt;• Déposer une offre globale chiffrée scellée SHA-256 (UC03)&lt;br&gt;• Modifier son offre avant clôture des candidatures&lt;br&gt;• Gérer ses RIB bancaires (&lt;code&gt;/api/v1/fournisseurs/moi&lt;/code&gt;)&lt;br&gt;• Suivre l'état de ses soumissions et paiements (UC14)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#FFFFFF;'&gt;&lt;td&gt;&lt;b style='color:#475569;'&gt;GESTIONNAIRE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748B;'&gt;Gestionnaire de Crédit&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;span style='background:#E0E7FF;color:#3730A3;padding:2px 4px;border-radius:3px;font-weight:bold;'&gt;Interne&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Programme / Direction&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Suivi analytique et reporting de l'exécution du budget et des dépenses en cours, sans pouvoir d'engagement juridique.&lt;/td&gt;&lt;td&gt;&lt;code&gt;CONSULTER&lt;/code&gt;&lt;br&gt;&lt;code&gt;ENGAGE_DEPENSE&lt;/code&gt;*, &lt;code&gt;VISA_CFI&lt;/code&gt;*&lt;/td&gt;&lt;td&gt;• Consulter le solde disponible des lignes de crédit (AE/CP)&lt;br&gt;• Consulter les expressions de besoin et offres reçues&lt;br&gt;• Suivre les étapes du cycle de vie des actes juridiques&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#F8FAFC;'&gt;&lt;td&gt;&lt;b style='color:#64748B;'&gt;AGENT&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748B;'&gt;Agent Public (Socle)&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;span style='background:#E0E7FF;color:#3730A3;padding:2px 4px;border-radius:3px;font-weight:bold;'&gt;Interne&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Personnel&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Rôle technique de base attribué à tout agent public référencé dans le système.&lt;/td&gt;&lt;td&gt;&lt;code&gt;CONSULTER&lt;/code&gt;&lt;/td&gt;&lt;td&gt;• Accéder à son profil et modifier ses données personnelles&lt;br&gt;• Configurer son authentification multifacteur (TOTP MFA)&lt;br&gt;• Changer son mot de passe initial&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="840" width="2480" x="100" y="1230" as="geometry" />
                </mxCell>
